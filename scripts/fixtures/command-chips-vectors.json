    {
      "id": "block-fence",
      "input": {
        "label": "Morning sync",
        "text": "bob gcal sync -n 2\nbob gkeep pull\nbob gmail sync"
      },
      "expected": {
        "ok": true,
        "form": "block",
        "markdown": "```bob-run Morning sync\nbob gcal sync -n 2\nbob gkeep pull\nbob gmail sync\n```"
      }
    },
    {
      "id": "block-unlabeled",
      "input": {
        "label": null,
        "text": "bob gcal sync -n 2\nbob gkeep pull"
      },
      "expected": {
        "ok": true,
        "form": "block",
        "markdown": "```bob-run\nbob gcal sync -n 2\nbob gkeep pull\n```"
      }
    },
    {
      "id": "tilde-when-label-has-backtick",
      "input": {
        "label": "see `this`",
        "text": "bob plan\nbob task reconcile"
      },
      "expected": {
        "ok": true,
        "form": "block",
        "markdown": "~~~bob-run see `this`\nbob plan\nbob task reconcile\n~~~"
      }
    },
    {
      "id": "indented-block",
      "input": {
        "label": "Sync",
        "text": "bob gkeep pull\nbob gmail sync"
      },
      "opts": {
        "indent": "  "
      },
      "expected": {
        "ok": true,
        "form": "block",
        "markdown": "  ```bob-run Sync\n  bob gkeep pull\n  bob gmail sync\n  ```"
      }
    },
    {
      "id": "nothing-to-run",
      "input": {
        "label": null,
        "text": "   "
      },
      "expected": {
        "ok": false,
        "reason": "nothing to run"
      }
    },
    {
      "id": "label-newline",
      "input": {
        "label": "a\nb",
        "text": "bob plan"
      },
      "expected": {
        "ok": false,
        "reason": "labels are one line"
      }
    },
    {
      "id": "block-in-table-refused",
      "input": {
        "label": null,
        "text": "bob plan\nbob task reconcile"
      },
      "opts": {
        "table": true
      },
      "expected": {
        "ok": false,
        "reason": "can't put a bob-run fence in a table cell"
      }
    },
    {
      "id": "crlf-normalizes-to-lf",
      "input": {
        "label": null,
        "text": "bob plan\r\nbob gkeep pull"
      },
      "expected": {
        "ok": true,
        "form": "block",
        "markdown": "```bob-run\nbob plan\nbob gkeep pull\n```"
      }
    },
    {
      "id": "blank-label-is-no-label",
      "input": {
        "label": "   ",
        "text": "bob plan"
      },
      "expected": {
        "ok": true,
        "form": "inline",
        "markdown": "`run: bob plan`"
      }
    }
