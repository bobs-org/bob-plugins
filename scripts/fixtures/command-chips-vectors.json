{
  "chips": [
    {
      "id": "unlabeled",
      "line": "`run: bob task reconcile`",
      "expected": [
        {
          "from": 0,
          "to": 25,
          "raw": "`run: bob task reconcile`",
          "label": null,
          "text": "bob task reconcile"
        }
      ]
    },
    {
      "id": "labeled-sequence",
      "line": "`run[Sync calendar and inboxes]: bob gcal sync -n 2 && bob gkeep pull && bob gmail sync`",
      "expected": [
        {
          "from": 0,
          "to": 88,
          "raw": "`run[Sync calendar and inboxes]: bob gcal sync -n 2 && bob gkeep pull && bob gmail sync`",
          "label": "Sync calendar and inboxes",
          "text": "bob gcal sync -n 2 && bob gkeep pull && bob gmail sync"
        }
      ]
    },
    {
      "id": "several-on-one-line",
      "line": "Run `run: bob task reconcile` then `run: bob plan`",
      "expected": [
        {
          "from": 4,
          "to": 29,
          "raw": "`run: bob task reconcile`",
          "label": null,
          "text": "bob task reconcile"
        },
        {
          "from": 35,
          "to": 50,
          "raw": "`run: bob plan`",
          "label": null,
          "text": "bob plan"
        }
      ]
    },
    {
      "id": "double-run-with-inner-backticks",
      "line": "``run: bob task add \"fix `x`\"``",
      "expected": [
        {
          "from": 0,
          "to": 31,
          "raw": "``run: bob task add \"fix `x`\"``",
          "label": null,
          "text": "bob task add \"fix `x`\""
        }
      ]
    },
    {
      "id": "padded-span",
      "line": "`` run: bob task add a` ``",
      "expected": [
        {
          "from": 0,
          "to": 26,
