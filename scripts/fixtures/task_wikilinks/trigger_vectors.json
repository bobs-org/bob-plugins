    { "name": "at_sigil_in_query", "line": "((@foo", "ch": "end", "expected": { "query": "@foo", "replace": [0, 6], "closed": false, "removal": { "start": 1, "end": 6, "caretCh": 1 } } },
    { "name": "autopair_closed_empty", "line": "(())", "ch": 2, "expected": { "query": "", "replace": [0, 4], "closed": true, "removal": { "start": 1, "end": 3, "caretCh": 1 } } },
    { "name": "autopair_closed_query", "line": "((fo))", "ch": 4, "expected": { "query": "fo", "replace": [0, 6], "closed": true, "removal": { "start": 1, "end": 5, "caretCh": 1 } } },
    { "name": "empty_query_unclosed", "line": "((", "ch": "end", "expected": { "query": "", "replace": [0, 2], "closed": false, "removal": { "start": 1, "end": 2, "caretCh": 1 } } },
    { "name": "query_with_dash_and_digits", "line": "fix ((bug-12", "ch": "end", "expected": { "query": "bug-12", "replace": [4, 12], "closed": false, "removal": { "start": 5, "end": 12, "caretCh": 5 } } },
    { "name": "last_token_wins", "line": "((a ((b", "ch": "end", "expected": { "query": "b", "replace": [4, 7], "closed": false, "removal": { "start": 5, "end": 7, "caretCh": 5 } } },
    { "name": "caret_at_first_of_two_tokens", "line": "((a ((b", "ch": 1, "expected": { "query": "", "replace": [0, 3], "closed": false, "removal": { "start": 1, "end": 3, "caretCh": 1 } } }
