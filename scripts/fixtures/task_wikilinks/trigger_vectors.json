    { "name": "unclosed_token_stops_before_single_paren", "line": "Follow up ((foo) bar", "ch": 15, "expected": { "query": "foo", "replace": [10, 15], "closed": false, "removal": { "start": 11, "end": 15, "caretCh": 11 } } },
    { "name": "unclosed_token_stops_before_backtick", "line": "Follow up ((foo`code`)", "ch": 15, "expected": { "query": "foo", "replace": [10, 15], "closed": false, "removal": { "start": 11, "end": 15, "caretCh": 11 } } },
    { "name": "closed_token_caret_at_start", "line": "((foo))", "ch": 0, "expected": { "query": "", "replace": [0, 7], "closed": true, "removal": { "start": 1, "end": 6, "caretCh": 1 } } },
    { "name": "closed_token_caret_second_paren", "line": "((foo))", "ch": 2, "expected": { "query": "", "replace": [0, 7], "closed": true, "removal": { "start": 1, "end": 6, "caretCh": 1 } } },
    { "name": "closed_token_caret_mid_query", "line": "((foo))", "ch": 4, "expected": { "query": "fo", "replace": [0, 7], "closed": true, "removal": { "start": 1, "end": 6, "caretCh": 1 } } },
