{
  "format": 1,
  "source": "bob-cli src/native/capture_task_wikilinks.rs unit cases plus Obsidian-note-only exclusions",
  "notes": [
    "ch may be a UTF-16 offset or the string \"end\" (the line length).",
    "Expected token replacements are [start, end) UTF-16 offsets.",
    "JS offsets are UTF-16 code units; bob's byte offsets differ on multi-byte lines by construction (see multibyte_prefix).",
    "Notice strings are asserted literally so a drift in the guard wording fails loudly."
  ],
  "tokens": [
    { "name": "opener_at_line_start", "line": "((s", "ch": "end", "expected": { "query": "s", "replace": [0, 3], "closed": false, "removal": { "start": 1, "end": 3, "caretCh": 1 } } },
    { "name": "opener_after_space", "line": "Follow up ((s", "ch": "end", "expected": { "query": "s", "replace": [10, 13], "closed": false, "removal": { "start": 11, "end": 13, "caretCh": 11 } } },
    { "name": "opener_after_tab", "line": "a\t((s", "ch": "end", "expected": { "query": "s", "replace": [2, 5], "closed": false, "removal": { "start": 3, "end": 5, "caretCh": 3 } } },
    { "name": "opener_at_line_start_after_tab", "line": "\t((s", "ch": "end", "expected": { "query": "s", "replace": [1, 4], "closed": false, "removal": { "start": 2, "end": 4, "caretCh": 2 } } },
    { "name": "mid_word_never_triggers", "line": "f((x", "ch": 4, "expected": null },
    { "name": "triple_paren_never_triggers", "line": "(((foo", "ch": 6, "expected": null },
    { "name": "triple_paren_after_space_never_triggers", "line": " (((foo", "ch": 7, "expected": null },
    { "name": "quad_paren_never_triggers", "line": "(((( x", "ch": "end", "expected": null },
    { "name": "closed_token_query_inside", "line": "Follow up ((foo)) more", "ch": 14, "expected": { "query": "fo", "replace": [10, 17], "closed": true, "removal": { "start": 11, "end": 16, "caretCh": 11 } } },
    { "name": "closed_token_caret_at_opener", "line": "Follow up ((foo)) more", "ch": 10, "expected": { "query": "", "replace": [10, 17], "closed": true, "removal": { "start": 11, "end": 16, "caretCh": 11 } } },
    { "name": "closed_token_caret_at_closer_end", "line": "Follow up ((foo)) more", "ch": 17, "expected": { "query": "foo", "replace": [10, 17], "closed": true, "removal": { "start": 11, "end": 16, "caretCh": 11 } } },
    { "name": "closed_token_caret_past_closer", "line": "Follow up ((foo)) more", "ch": 18, "expected": null },
